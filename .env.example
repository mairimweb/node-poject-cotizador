# --- MongoDB Atlas ---
MONGODB_URI="mongodb+srv://usuario:password@cluster.mongodb.net/cotizador?retryWrites=true&w=majority"

# --- Servidor ---
# En producción usar NODE_ENV=production (el servidor sirve el SPA desde client/dist).
NODE_ENV=development
# En Hostinger el PORT lo inyecta la plataforma; en local usa 4000.
PORT=4000
# Dev: http://localhost:5173 | Prod: https://<tu-dominio>
CORS_ORIGIN=http://localhost:5173

# --- Seguridad ---
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=""
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Usuario admin inicial (seed) ---
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrador
ADMIN_PASSWORD=CambiaEstaPassw0rd!
